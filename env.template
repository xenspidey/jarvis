# 02-bootstrap.sh appends this block to the END of ~/.hermes/.env (the Hermes installer
# creates that file with its own defaults above). Keep the file chmod 600.

# --- Model ---
ANTHROPIC_API_KEY=

# --- Telegram ---  (token from @BotFather, numeric ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# --- Microsoft Teams ---  (`teams app create` prints CLIENT_ID / CLIENT_SECRET / TENANT_ID
# without the TEAMS_ prefix; `teams status --verbose` prints your User Object ID)
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
TEAMS_ALLOWED_USERS=
# TEAMS_PORT=3978
# TEAMS_HOST=          # unset = listen on all interfaces (xen-pxy needs that); see README step 6
# TEAMS_REQUIRE_MENTION=true
